RESEND_API_KEY=
EMAIL_FROM=
OWNER_EMAIL=
# Manual payment instructions: no automatic recurring billing.
GCASH_NUMBER=
GCASH_ACCOUNT_NAME=
PAYPAL_PAYMENT_URL=
MEMBERSHIP_PRICE_PHP=199
MEMBERSHIP_DAYS=30

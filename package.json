{
  "name": "mq3-music",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.js",
    "build": "node scripts/build.js",
    "db:setup": "node --env-file-if-exists=.env.local scripts/db.js",
    "password": "node scripts/password.js",
